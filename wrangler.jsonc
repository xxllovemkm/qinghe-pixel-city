{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qinghe-pixel-city",
  "account_id": "64adb6135d8f2b3fd3e4588919713bf5",
  "main": "vinext/server/fetch-handler",
  // Matches the workerd runtime pinned in package-lock.json.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "qinghe-pixel-city-staging",
    },
    "production": {
      "name": "qinghe-pixel-city",
    },
  },
}
